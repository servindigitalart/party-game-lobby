<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Theme applied to the Android Window while the process is starting.

      Fase 2B WP6: this used to inherit `?android:colorBackground` from the
      platform theme, which resolved to pure white in light mode and — via the
      old `values-night` variant — to pure black in dark mode. The app has no
      dark mode (`themeMode: ThemeMode.light`), so a player with the OS in dark
      mode launched into a black window and then straight into a near-white
      Flutter frame. The branded `splash_isotype` drawables had been sitting in
      all five density buckets, unreferenced, since Fase 2A.

      There is no `values-night` counterpart on purpose: an app that always
      renders its light register must not declare a dark launch appearance.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!--
      Theme applied as soon as the process has started — the window behind the
      Flutter UI while it initialises, and behind it afterwards. Pinned to the
      colour Flutter's own first frame paints, so the handoff is invisible.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/bufon_surface</item>
    </style>
</resources>
