<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required by Firebase App Check's App Attest provider. Without this
	     entitlement App Attest cannot mint a token and the client falls back
	     to DeviceCheck, which is weaker attestation.

	     `production` is the correct value for App Store and TestFlight
	     builds; Xcode rewrites it to `development` for debug signing. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
</dict>
</plist>
